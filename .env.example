# SQLite file, relative to prisma/. On Railway: file:/app/storage/cutline.db
DATABASE_URL="file:../storage/cutline.db"
# Uploaded videos. On Railway: /app/storage (the mounted volume)
STORAGE_DIR="./storage"
# Generate with: openssl rand -base64 32   (use a different value on Railway)
AUTH_SECRET=""
# Optional. 32 random bytes, base64 (openssl rand -base64 32). If left empty, the key that
# encrypts stored TikTok tokens is derived from AUTH_SECRET instead.
TOKEN_ENCRYPTION_KEY=""
# From the TikTok developer portal (your app's Client key / Client secret)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Must exactly match the Redirect URI in the TikTok portal. On Railway: https://<your-domain>/api/auth/tiktok/callback
TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/tiktok/callback"
# Set to false to stop new people signing up (existing users can still log in)
ALLOW_SIGNUPS="true"
